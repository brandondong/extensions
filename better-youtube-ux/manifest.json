{
  "manifest_version": 3,
  "name": "Better Youtube UX",
  "version": "0.1",
  "description": "Opens Shorts in the normal video player, disables theater escape, and other goodies.",
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*"
      ],
      "all_frames": true,
      "js": [
        "youtube.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*"
  ]
}